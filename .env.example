# このファイルは変数名を共有するためのもの。値は書かないこと。
# 実際の値は .env.local に書く（.gitignore 済み）。

# Supabase
# ローカル環境の値は `npx supabase status` で確認できる。
# クラウド環境の値は Supabase ダッシュボードの Project Settings > API から取得する。
# PUBLISHABLE_KEY は旧 anon キーの後継。公開してよい（RLS が前提）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント ID から取得する。
# supabase/config.toml から env() 経由で参照するため、CLI 側にも読ませる必要がある。
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
